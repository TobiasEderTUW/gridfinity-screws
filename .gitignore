# --- generated build output ---------------------------------------------------
# Server-built 3MF files land here (OUT_DIR=/data/out, bind-mounted to ./out).
out/

# --- service cache -------------------------------------------------------------
# Built 3MF files and job results (CACHE_DIR). The label assets the builds need are
# source and live in generator/assets/.
cache/

# --- shared editor state -------------------------------------------------------
# The default drawer saved with "Set as default", and the defaults it replaced.
# Data of the installation, not source; back it up on the lab server.
state/

# Drawer assembly artifacts (assemble_final_drawer_v9.py)
fertige_schublade_*
drawer_layout_*.png
drawer_layout_*_preview.csv
bin_fit_audit.csv
*.tar.gz

# --- python -------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
build/
dist/

# keep lockfiles tracked: api/uv.lock

# --- tooling caches -----------------------------------------------------------
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- local config -------------------------------------------------------------
.env
.env.*
!.env.example

